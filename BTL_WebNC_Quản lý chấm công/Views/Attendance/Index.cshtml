@* Chèn đoạn này vào Views/Attendance/Index.cshtml (giữ nguyên @model và giao diện hiện tại). *@
<section class="card mb-3">
    <div class="card-header">Thực hành buổi 7 - Cookies và Session</div>
    <div class="card-body">
        <p><strong>Lượt truy cập (Persistent Cookie):</strong> @ViewBag.CookieVisitCount</p>
        <p><strong>Lần truy cập trước (giờ Việt Nam):</strong> @ViewBag.CookiePreviousVisit</p>
        <p><strong>Lượt mở trong Session:</strong> @ViewBag.SessionViews</p>
        <p><strong>Tài khoản:</strong> @ViewBag.SessionUserName</p>
        <p><strong>Vai trò:</strong> @ViewBag.SessionRole</p>
        <p><strong>Chức năng gần nhất:</strong> @ViewBag.SessionLastFeature</p>
    </div>
</section>
