
@model BTL_WebNC_Quản_lý_chấm_công.Models.Department

@{
    ViewData["Title"] = "Ngừng hoạt động phòng ban";
}

<h2 class="mb-4">Ngừng hoạt động phòng ban</h2>

<div class="alert alert-warning">
    Bạn có chắc chắn muốn ngừng hoạt động phòng ban
    <strong>@Model.DepartmentName</strong>?
</div>

<p>
    Phòng ban sẽ được chuyển sang trạng thái Inactive,
    không bị xóa khỏi cơ sở dữ liệu.
</p>

<form asp-action="Delete"
      asp-route-id="@Model.DepartmentID"
      method="post">

    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Xác nhận ngừng hoạt động
    </button>

    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

