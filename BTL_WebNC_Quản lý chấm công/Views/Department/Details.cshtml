
@model BTL_WebNC_Quản_lý_chấm_công.Models.Department

@{
    ViewData["Title"] = "Chi tiết phòng ban";
}

<h2 class="mb-4">Chi tiết phòng ban</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Mã phòng ban</dt>
            <dd class="col-sm-8">@Model.DepartmentID</dd>

            <dt class="col-sm-4">Tên phòng ban</dt>
            <dd class="col-sm-8">@Model.DepartmentName</dd>

            <dt class="col-sm-4">Mô tả</dt>
            <dd class="col-sm-8">
                @(Model.Description ?? "Chưa có mô tả")
            </dd>

            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">
                @(Model.Status == "Active" ? "Hoạt động" : "Ngừng hoạt động")
            </dd>
        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.DepartmentID"
           class="btn btn-warning">Sửa</a>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại
        </a>
    </div>
</div>
