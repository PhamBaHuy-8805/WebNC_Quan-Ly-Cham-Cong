@model string
@{ var label = Model switch { "Pending" => "Chờ duyệt", "Approved" => "Đã duyệt", "Rejected" => "Từ chối", "Cancelled" => "Đã hủy", _ => Model };
   var color = Model switch { "Approved" => "success", "Rejected" => "danger", "Cancelled" => "warning", _ => "secondary" }; }
<span class="badge bg-@color">@label</span>
