@{
    ViewData["Title"] = "Quản lý nhân viên - AJAX";
}
<div class="container py-4" id="employeeAjax" data-base-url="@Url.Content("~/ajax/employees")">
    <h2>Quản lý nhân viên - AJAX</h2>
    <p class="text-muted">Hiển thị: XMLHttpRequest · Thêm/Xóa: jQuery AJAX · Tìm kiếm: fetch() · Phân trang: EF Core Skip/Take</p>
    @Html.AntiForgeryToken()

    <div class="card mb-3"><div class="card-body">
        <h5>Lọc và tìm kiếm</h5>
        <div class="row g-2">
            <div class="col-md-4"><input id="empKeyword" class="form-control" placeholder="Mã hoặc họ tên nhân viên" /></div>
            <div class="col-md-3"><select id="empDepartmentFilter" class="form-select"><option value="">Tất cả phòng ban</option></select></div>
            <div class="col-md-3"><select id="empPositionFilter" class="form-select"><option value="">Tất cả chức vụ</option></select></div>
            <div class="col-md-2"><select id="empStatusFilter" class="form-select">
                <option value="">Mọi trạng thái</option><option value="Active">Đang làm</option><option value="Inactive">Ngừng làm</option>
            </select></div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="button" id="empSearch" class="btn btn-primary">Tìm kiếm (fetch)</button>
            <button type="button" id="empReset" class="btn btn-outline-secondary">Làm mới (XHR)</button>
        </div>
    </div></div>

    <div class="card mb-3"><div class="card-body">
        <h5>Thêm nhân viên (jQuery AJAX)</h5>
        <form id="empCreateForm">
            <div class="row g-2">
                <div class="col-md-3"><label class="form-label">Mã nhân viên *</label><input class="form-control" name="EmployeeCode" maxlength="20" required /></div>
                <div class="col-md-3"><label class="form-label">Họ tên *</label><input class="form-control" name="FullName" maxlength="100" required /></div>
                <div class="col-md-3"><label class="form-label">Ngày sinh</label><input class="form-control" name="DateOfBirth" type="date" /></div>
                <div class="col-md-3"><label class="form-label">Giới tính</label><select class="form-select" name="Gender">
                    <option value="">Chọn</option><option value="Nam">Nam</option><option value="Nữ">Nữ</option><option value="Khác">Khác</option>
                </select></div>
                <div class="col-md-3"><label class="form-label">Điện thoại</label><input class="form-control" name="Phone" maxlength="15" /></div>
                <div class="col-md-3"><label class="form-label">Email</label><input class="form-control" name="Email" type="email" maxlength="254" /></div>
                <div class="col-md-6"><label class="form-label">Địa chỉ</label><input class="form-control" name="Address" maxlength="255" /></div>
                <div class="col-md-3"><label class="form-label">Phòng ban</label><select id="empDepartmentCreate" class="form-select" name="DepartmentID"><option value="">Chọn phòng ban</option></select></div>
                <div class="col-md-3"><label class="form-label">Chức vụ</label><select id="empPositionCreate" class="form-select" name="PositionID"><option value="">Chọn chức vụ</option></select></div>
                <div class="col-md-3"><label class="form-label">Ngày vào làm *</label><input class="form-control" name="HireDate" type="date" required /></div>
                <div class="col-md-3"><label class="form-label">Lương cơ bản</label><input class="form-control" name="Salary" type="number" min="0" step="0.01" value="0" required /></div>
                <div class="col-md-3"><label class="form-label">Trạng thái</label><select class="form-select" name="Status">
                    <option value="Active">Đang làm</option><option value="Inactive">Ngừng làm</option>
                </select></div>
            </div>
            <button type="submit" class="btn btn-success mt-3" id="empSave">Thêm nhân viên</button>
        </form>
    </div></div>

    <div id="empNotice" class="mb-2" role="status" aria-live="polite"></div>
    <div class="table-responsive"><table class="table table-striped table-bordered align-middle">
        <thead class="table-light"><tr>
            <th>ID</th><th>Mã NV</th><th>Họ tên</th><th>Phòng ban</th><th>Chức vụ</th>
            <th>Email</th><th>Ngày vào</th><th>Lương</th><th>Trạng thái</th><th>Thao tác</th>
        </tr></thead><tbody id="empRows"><tr><td colspan="10">Đang tải...</td></tr></tbody>
    </table></div>
    <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <div id="empCount" class="text-muted"></div><div id="empPager" class="d-flex gap-2 align-items-center"></div>
    </div>
    <div class="mt-4"><a href="@Url.Content("~/ajax/departments")">Quản lý phòng ban</a> · <a href="@Url.Content("~/ajax/positions")">Quản lý chức vụ</a></div>
</div>
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/employee-ajax.js" asp-append-version="true"></script>
}
