
@model BTL_WebNC_Quản_lý_chấm_công.Models.Position

@{
    ViewData["Title"] = "Chi tiết chức vụ";
}

<h2 class="mb-4">Chi tiết chức vụ</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Mã chức vụ</dt>
            <dd class="col-sm-8">@Model.PositionID</dd>

            <dt class="col-sm-4">Tên chức vụ</dt>
            <dd class="col-sm-8">@Model.PositionName</dd>

            <dt class="col-sm-4">Mô tả</dt>
            <dd class="col-sm-8">
                @(Model.Description ?? "Chưa có mô tả")
            </dd>

            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">
                @(Model.Status == "Active" ? "Hoạt động" : "Ngừng hoạt động")
            </dd>
        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.PositionID"
           class="btn btn-warning">Sửa</a>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại
        </a>
    </div>
</div>
