
@model BTL_WebNC_Quản_lý_chấm_công.Models.Position

@{
    ViewData["Title"] = "Thêm chức vụ";
}

<h2 class="mb-4">Thêm chức vụ</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="PositionName" class="form-label">
                    Tên chức vụ *
                </label>
                <input asp-for="PositionName" class="form-control" />
                <span asp-validation-for="PositionName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    Mô tả
                </label>
                <textarea asp-for="Description"
                          class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Lưu</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
