
@model BTL_WebNC_Quản_lý_chấm_công.Models.Employee

@{
    ViewData["Title"] = "Thêm nhân viên";
}

<h2 class="mb-4">Thêm nhân viên mới</h2>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        Thông tin nhân viên
    </div>

    <div class="card-body">
        <form asp-controller="Employee"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <partial name="_EmployeeForm" model="Model" />

            <div class="mt-3">
                <button type="submit"
                        class="btn btn-success">
                    Lưu nhân viên
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
