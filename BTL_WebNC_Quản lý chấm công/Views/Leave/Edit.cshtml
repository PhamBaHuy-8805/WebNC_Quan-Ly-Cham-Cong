@model LeaveCreateViewModel
@{ ViewData["Title"] = "Sửa đơn nghỉ phép"; }
<h1>@ViewData["Title"]</h1>
<div class="row"><div class="col-lg-6">
<form asp-action="Edit" asp-route-id="@ViewData["RequestId"]" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
