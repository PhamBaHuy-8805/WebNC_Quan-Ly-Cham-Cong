@model RequestListViewModel<Leave>
@{ ViewData["Title"] = "Đơn nghỉ phép"; }
<div id="request-app" data-list-url="@Url.Action("Index")" data-delete-url="@Url.Action("Delete")"
     data-details-url="@Url.Action("Details")" data-edit-url="@Url.Action("Edit")"
     data-approve-url="@Url.Action("Approve")" data-reject-url="@Url.Action("Reject")" data-page="@Model.Page">
<div id="request-message" role="alert" hidden></div>
<h1>@ViewData["Title"]</h1>
@if (User.IsInRole("Employee"))
{
    <p><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#request-modal">Tạo yêu cầu</button></p>
}
<form id="request-search" asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5"><label asp-for="Search" class="form-label">Mã, tên nhân viên hoặc lý do</label><input asp-for="Search" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Status" class="form-label">Trạng thái</label>
        <select asp-for="Status" class="form-select"><option value="">Tất cả</option><option value="Pending">Chờ duyệt</option><option value="Approved">Đã duyệt</option><option value="Rejected">Từ chối</option></select>
    </div>
    <div class="col-md-3"><label asp-for="Sort" class="form-label">Sắp xếp</label>
        <select asp-for="Sort" class="form-select"><option value="date_desc">Ngày mới trước</option><option value="date">Ngày cũ trước</option><option value="name">Tên nhân viên</option><option value="status">Trạng thái</option></select>
    </div>
    <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary" type="submit">Lọc</button></div>
</form>
<p id="request-summary" role="status" aria-live="polite"></p>
<div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>Nhân viên</th><th>Thời gian</th><th>Trạng thái</th><th>Người xử lý</th><th>Thao tác</th></tr></thead>
    <tbody id="request-rows"></tbody>
</table></div>
<nav aria-label="Phân trang"><div id="request-pages" class="d-flex gap-2 flex-wrap"></div></nav>
<div id="request-token">@Html.AntiForgeryToken()</div>
<noscript><p class="alert alert-warning">Vui lòng bật JavaScript để sử dụng danh sách đơn.</p></noscript>
@if (User.IsInRole("Employee"))
{
    <div class="modal fade" id="request-modal" tabindex="-1" aria-labelledby="request-modal-title" aria-hidden="true">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="request-modal-title">Tạo yêu cầu</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="request-create" asp-action="Create" method="post">
                <div class="modal-body">
                    <div id="request-errors" class="alert alert-danger" role="alert" hidden></div>
                    <partial name="_Form" model="new LeaveCreateViewModel()" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Gửi yêu cầu</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </form>
        </div></div>
    </div>
}
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/requests.js" asp-append-version="true"></script>
}
