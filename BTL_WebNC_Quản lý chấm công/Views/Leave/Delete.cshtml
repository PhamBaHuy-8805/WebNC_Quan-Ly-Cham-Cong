@model Leave
@{ ViewData["Title"] = "Xóa đơn nghỉ phép"; }
<h1>@ViewData["Title"]</h1>
<p class="alert alert-warning">Bạn có chắc muốn xóa đơn đang chờ duyệt này?</p>
<partial name="_Details" model="Model" />
<form asp-action="Delete" asp-route-id="@Model.LeaveID" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Details" asp-route-id="@Model.LeaveID" class="btn btn-outline-secondary">Hủy</a>
</form>
